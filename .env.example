# IronCoach Konfiguration
# Kopiere diese Datei nach .env und fülle deine Werte ein.
# .env wird NICHT ins Git-Repo gepusht (siehe .gitignore).

# Sicherheit (mindestens 32 Zeichen, zufällig generiert!)
JWT_SECRET=dein-super-geheimer-jwt-schluessel-mindestens-32-zeichen-lang
SESSION_SECRET=dein-super-geheimer-session-schluessel-mindestens-32-zeichen

# Google OAuth (optional - für Google Login)
GOOGLE_CLIENT_ID=deine-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dein-google-client-secret

# Lokale Entwicklung:
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Produktion (Render setzt RENDER_EXTERNAL_URL meist automatisch, daher optional):
# GOOGLE_CALLBACK_URL=https://deine-domain.com/auth/google/callback

# Google Drive Backup/Restore (standardmäßig aktiv, damit Login + Backup
# zusammen funktionieren). Mit false explizit deaktivieren.
GOOGLE_DRIVE_ENABLED=true

# Umgebung
# Lokal immer development, damit Session-Cookies unter http://localhost funktionieren.
# Auf Render setzt du NODE_ENV=production im Dashboard.
NODE_ENV=development

# CORS (für Produktion)
ALLOWED_ORIGIN=https://deine-domain.com

# Sprach-Eintrag (lokal, siehe VOICE-SETUP.md)
# whisper.cpp-Server: wird von start_whisper.ps1 / start_ironcoach_tailscale.ps1 gestartet
WHISPER_SERVER_EXE=C:\tools\whisper\whisper-server.exe
WHISPER_MODEL_PATH=C:\tools\whisper\models\ggml-large-v3-turbo-q5_0.bin
WHISPER_URL=http://127.0.0.1:8178/inference
WHISPER_LANGUAGE=de
# Optionaler LLM-Fallback ueber Ollama (leer = aus, regelbasierter Parser reicht meist)
# VOICE_LLM_MODEL=qwen2.5:3b
# OLLAMA_URL=http://127.0.0.1:11434
